{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "#f38ba8",
          "background": "#1e1e2e",
          "properties": {
            "style": "text",
            "template": "{% if .Root }}%{% endif %}"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#cdd6f4",
          "background": "#1e1e2e",
          "properties": {
            "text": " "
          }
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#89b4fa",
          "background": "#1e1e2e",
          "properties": {
            "template": "{{ .UserName }}"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#cdd6f4",
          "background": "#1e1e2e",
          "properties": {
            "text": " "
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#a6e3a1",
          "background": "#1e1e2e",
          "properties": {
            "style": "agnoster",
            "max_depth": 3,
            "template": "{{ .Path }}",
            "display_default_folder": true,
            "display_folder_icon": true,
            "display_home_icon": true,
            "display_relative_path": true
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#f9e2af",
          "background": "#1e1e2e",
          "properties": {
            "display_status": true,
            "display_stash_count": true,
            "display_upstream": true,
            "template": " {{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf0c7 {{ .Staging.String }}{{ end }}"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#89b4fa",
          "background": "#1e1e2e",
          "properties": {
            "display_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#89b4fa",
          "background": "#1e1e2e",
          "properties": {
            "display_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#94e2d5",
          "background": "#1e1e2e",
          "properties": {
            "error_color": "#f38ba8",
            "success_color": "#a6e3a1"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#89b4fa",
          "background": "#1e1e2e",
          "properties": {
            "format": "15:04:05"
          }
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
