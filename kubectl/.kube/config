apiVersion: v1
clusters:
- cluster:
    server: https://k8sv3-api.steelhome.internal:8443
  name: NJJ-K8SV3-PRD
- cluster:
    server: https://k8sv3stg-api.steelhome.internal:8443
  name: NJJ-K8SV3-STG
contexts:
- context:
    cluster: NJJ-K8SV3-PRD
    namespace: itsf-prd-odoorh-netsf
    user: oicd-k8s-njj-v3
  name: v3-prd
- context:
    cluster: NJJ-K8SV3-STG
    namespace: itsf-dev-galaxion-eir
    user: oicd-k8s-njj-v3
  name: v3-stg
current-context: v3-prd
kind: Config
preferences: {}
users:
- name: oicd-k8s-njj-v3
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - get-token
      - --listen-address=127.0.0.1:8000
      - --oidc-issuer-url=https://iam.steelhome.internal/auth/realms/steelhome
      - --oidc-client-id=mtMC-K8S-prd
      command: bin/kubelogin
      env: null
      interactiveMode: IfAvailable
      provideClusterInfo: false
