## Error Codes

### Standard Exit Codes
```bash
# Success codes
EXIT_SUCCESS=0          # Operation completed successfully
EXIT_WARNING=1         # Operation completed with warnings

# Error codes
EXIT_ERROR=2           # General error
EXIT_DEPENDENCY=3      # Missing dependency
EXIT_PERMISSION=4      # Permission error
EXIT_CONFIG=5          # Configuration error
EXIT_STOW=6           # Stow operation error
EXIT_MODULE=7         # Module-specific error
EXIT_NETWORK=8        # Network-related error
EXIT_VALIDATION=9     # Validation error
```

## Error Handling Functions

### 1. Basic Error Handling
```bash
# Error handling function
handle_error() {
    local exit_code=$1
    local error_message=$2
    local error_details=$3

    case $exit_code in
        $EXIT_SUCCESS)
            print_success "$error_message"
            ;;
        $EXIT_WARNING)
            print_warning "$error_message"
            print_status "$error_details"
            ;;
        $EXIT_DEPENDENCY)
            print_error "Dependency Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_PERMISSION)
            print_error "Permission Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_CONFIG)
            print_error "Configuration Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_STOW)
            print_error "Stow Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_MODULE)
            print_error "Module Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_NETWORK)
            print_error "Network Error: $error_message"
            print_status "Details: $error_details"
            ;;
        $EXIT_VALIDATION)
            print_error "Validation Error: $error_message"
            print_status "Details: $error_details"
            ;;
        *)
            print_error "Unknown Error: $error_message"
            print_status "Details: $error_details"
            ;;
    esac

    return $exit_code
}
```

### 2. Dependency Checking
```bash
check_dependency() {
    local dep=$1
    local version=$2

    if ! command -v "$dep" >/dev/null 2>&1; then
        handle_error $EXIT_DEPENDENCY \
            "Required dependency '$dep' not found" \
            "Please install $dep version $version or higher"
        return $EXIT_DEPENDENCY
    fi

    if [ -n "$version" ]; then
        local installed_version
        installed_version=$("$dep" --version 2>&1)
        if ! version_compare "$installed_version" "$version"; then
            handle_error $EXIT_DEPENDENCY \
                "Dependency '$dep' version mismatch" \
                "Required: $version, Installed: $installed_version"
            return $EXIT_DEPENDENCY
        fi
    fi

    return $EXIT_SUCCESS
}
```

### 3. Permission Checking
```bash
check_permissions() {
    local path=$1
    local required_perms=$2

    if [ ! -w "$path" ]; then
        handle_error $EXIT_PERMISSION \
            "Insufficient permissions for '$path'" \
            "Required permissions: $required_perms"
        return $EXIT_PERMISSION
    fi

    return $EXIT_SUCCESS
}
```

### 4. Configuration Validation
```bash
validate_config() {
    local config_file=$1
    local schema=$2

    if [ ! -f "$config_file" ]; then
        handle_error $EXIT_CONFIG \
            "Configuration file not found: $config_file" \
            "Please ensure the file exists and is readable"
        return $EXIT_CONFIG
    fi

    if ! validate_against_schema "$config_file" "$schema"; then
        handle_error $EXIT_CONFIG \
            "Invalid configuration in $config_file" \
            "Please check the configuration format"
        return $EXIT_CONFIG
    fi

    return $EXIT_SUCCESS
}
```

## Error Recovery

### 1. Backup and Restore
```bash
handle_stow_error() {
    local module=$1
    local error=$2

    # Create backup
    if ! backup_config "$module"; then
        handle_error $EXIT_STOW \
            "Failed to create backup for $module" \
            "Error: $error"
        return $EXIT_STOW
    fi

    # Attempt to fix the issue
    if ! fix_stow_issue "$module" "$error"; then
        # Restore from backup
        if ! restore_config "$module"; then
            handle_error $EXIT_STOW \
                "Failed to restore $module from backup" \
                "Error: $error"
            return $EXIT_STOW
        fi
    fi

    return $EXIT_SUCCESS
}
```

### 2. Cleanup on Error
```bash
cleanup_on_error() {
    local exit_code=$1
    local temp_dir=$2

    # Remove temporary files
    if [ -d "$temp_dir" ]; then
        rm -rf "$temp_dir"
    fi

    # Reset any changed environment variables
    reset_environment

    # Exit with the original error code
    exit $exit_code
}
```

