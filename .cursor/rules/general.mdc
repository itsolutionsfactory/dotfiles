## Module Structure
```
module_name/
├── .config/                    # Configuration directory
│   └── module_name/           # Module-specific config files
├── install.sh                 # Installation script
├── test.sh                   # Test script
└── README.md                 # Module documentation
```

## Module Discovery

### 1. Module Detection
```bash
discover_modules() {
    local modules_dir="$1"
    local -a modules=()

    # Find all directories containing install.sh
    while IFS= read -r -d '' module; do
        local module_name
        module_name=$(basename "$(dirname "$module")")
        modules+=("$module_name")
    done < <(find "$modules_dir" -maxdepth 2 -name "install.sh" -print0)

    echo "${modules[@]}"
}
```

### 2. Module Validation
```bash
validate_module() {
    local module_dir="$1"
    local module_name="$2"

    # Check required files
    local required_files=("install.sh" "test.sh" "README.md")
    for file in "${required_files[@]}"; do
        if [ ! -f "$module_dir/$file" ]; then
            handle_error $EXIT_MODULE \
                "Missing required file: $file" \
                "Module: $module_name"
            return $EXIT_MODULE
        fi
    done

    # Check configuration directory
    if [ ! -d "$module_dir/.config/$module_name" ]; then
        handle_error $EXIT_MODULE \
            "Missing configuration directory" \
            "Module: $module_name"
        return $EXIT_MODULE
    fi

    return $EXIT_SUCCESS
}
```

## Module Dependencies

### 1. Dependency Declaration
```bash
# In module's install.sh
declare -a MODULE_DEPENDENCIES=(
    "apt:package1"
    "apt:package2"
    "snap:package3"
    "module:other_module"
)
```

### 2. Dependency Resolution
```bash
resolve_dependencies() {
    local module_name="$1"
    local module_dir="$2"
    local -a resolved_deps=()
    local -a unresolved_deps=()

    # Load module dependencies
    source "$module_dir/install.sh"

    # Process each dependency
    for dep in "${MODULE_DEPENDENCIES[@]}"; do
        local type="${dep%%:*}"
        local name="${dep#*:}"

        case "$type" in
            "apt")
                if ! check_apt_package "$name"; then
                    unresolved_deps+=("$dep")
                else
                    resolved_deps+=("$dep")
                fi
                ;;
            "snap")
                if ! check_snap_package "$name"; then
                    unresolved_deps+=("$dep")
                else
                    resolved_deps+=("$dep")
                fi
                ;;
            "module")
                if ! check_module_installed "$name"; then
                    unresolved_deps+=("$dep")
                else
                    resolved_deps+=("$dep")
                fi
                ;;
        esac
    done

    echo "${unresolved_deps[@]}"
}
```

## Module Installation

### 1. Installation Process
```bash
install_module() {
    local module_name="$1"
    local module_dir="$2"

    print_header "Installing $module_name"

    # Validate module
    if ! validate_module "$module_dir" "$module_name"; then
        return $EXIT_MODULE
    fi

    # Check dependencies
    local -a unresolved_deps
    mapfile -t unresolved_deps < <(resolve_dependencies "$module_name" "$module_dir")
    if [ ${#unresolved_deps[@]} -gt 0 ]; then
        handle_error $EXIT_DEPENDENCY \
            "Unresolved dependencies for $module_name" \
            "Dependencies: ${unresolved_deps[*]}"
        return $EXIT_DEPENDENCY
    fi

    # Run module installation
    if ! "$module_dir/install.sh"; then
        handle_error $EXIT_MODULE \
            "Failed to install $module_name" \
            "Check the installation logs for details"
        return $EXIT_MODULE
    fi

    # Run module tests
    if ! "$module_dir/test.sh"; then
        handle_error $EXIT_MODULE \
            "Tests failed for $module_name" \
            "Check the test logs for details"
        return $EXIT_MODULE
    fi

    print_success "Successfully installed $module_name"
    return $EXIT_SUCCESS
}
```

### 2. Module Removal
```bash
remove_module() {
    local module_name="$1"
    local module_dir="$2"

    print_header "Removing $module_name"

    # Create backup
    if ! backup_config "$module_name"; then
        handle_error $EXIT_MODULE \
            "Failed to backup $module_name" \
            "Aborting removal"
        return $EXIT_MODULE
    fi

    # Remove stow links
    if ! stow -D -t "$HOME/.config" .config; then
        handle_error $EXIT_STOW \
            "Failed to remove stow links for $module_name" \
            "Check the stow logs for details"
        return $EXIT_STOW
    fi

    print_success "Successfully removed $module_name"
    return $EXIT_SUCCESS
}
```

